# Enable Turnstile on production by setting TURNSTILE_ENABLED=true and the server-only secret.
# Local development remains unchallenged when both values are unset/false.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Set true only when the origin is reachable exclusively through Cloudflare's trusted proxy.
TRUST_PROXY=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MEDIA_ENABLED=false
TELEGRAM_MEDIA_GROUP_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# أصول CORS المسموحة مفصولة بفواصل، مثال: https://example.com,https://example.github.io
ALLOWED_ORIGINS=
# عنوان ومنفذ الخادم (Docker يضبطهما افتراضيًا داخل الحاوية)
HOST=127.0.0.1
PORT=8080
# منفذ المضيف عند التشغيل عبر Docker Compose
HOST_PORT=8080
# مسار تخزين ملفات المكتبة/الفهرس (اختياري؛ مفيد مع وحدات تخزين دائمة في الإنتاج)
# الأولوية: خيار صريح في الكود > STORAGE_DIRECTORY (بعد trim) > storage/ الافتراضي. القيم الفارغة/المسافات تُتجاهل.
STORAGE_DIRECTORY=


# Cloudflare R2 (primary library file store). All server-only; never expose in frontend.
# Bucket (private): haress-media. Token scope: Object Read & Write on haress-media only.
R2_BUCKET=haress-media
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
